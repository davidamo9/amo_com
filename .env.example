# Railway Backend API URL for Streamflow AI chatbot
# Get this URL from your Railway project dashboard
RAILWAY_API_URL=https://your-railway-app.up.railway.app

# Google Analytics 4 measurement ID (analytics.google.com -> Admin -> Data Streams)
# Analytics is disabled entirely when this is unset
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification token (HTML tag method, content="..." value only)
GOOGLE_SITE_VERIFICATION=your-verification-token

# Note: Make sure to add 'https://aungmyintoo.com' to Railway's FRONTEND_URL environment variable
# Railway CORS Configuration (set in Railway dashboard):
# FRONTEND_URL=https://aungmyintoo.com
